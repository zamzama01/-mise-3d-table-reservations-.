# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JWT authentication tokens.
JWT_SECRET="replace-with-a-long-random-secret"

# CLOUDINARY_*: Optional Cloudinary credentials for cloud restaurant image uploads.
# When omitted, images are uploaded cleanly to local persistent /uploads storage.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# GMAIL_*: Gmail address and 16-character App Password for Nodemailer booking confirmations.
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

